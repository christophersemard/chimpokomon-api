  <a class="mt-8 inline-flex rounded-lg bg-slate-900 px-5 py-3 font-medium text-white hover:bg-slate-700" href="{{ path('app.swagger_ui') }}">
    Consulter la documentation API
  </a>
</main>

{% endblock %}
