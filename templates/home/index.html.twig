{% extends 'base.html.twig' %}

{% block title %}Chimpokomon API{% endblock %}

{% block body %}

<main class="mx-auto max-w-3xl px-6 py-16">
  <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-emerald-600">Symfony 7 · API REST</p>
  <h1 class="text-4xl font-bold text-slate-900">Chimpokomon API</h1>
  <p class="mt-5 text-lg text-slate-600">
